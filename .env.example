KAIRO_ENV=development
KAIRO_LOG_LEVEL=INFO
KAIRO_DATA_ROOT=./03_DATA
KAIRO_REQUIRE_APPROVAL_FOR_CRITICAL=true

# The HTTP API rejects privileged requests unless all three values are set.
# Generate and store the bearer token outside source control.
KAIRO_API_TOKEN=
KAIRO_API_IDENTITY=kairo-api
KAIRO_API_PERMISSIONS=

# Sandbox capability switches default to disabled. Enabling them is not an
# authorization grant: identities still need permissions and scoped approval.
KAIRO_SANDBOX_ALLOW_NETWORK=false
KAIRO_SANDBOX_ALLOW_FILESYSTEM_WRITE=false
KAIRO_SANDBOX_ALLOW_PROCESS_EXECUTION=false
KAIRO_SANDBOX_ALLOW_SHELL=false
