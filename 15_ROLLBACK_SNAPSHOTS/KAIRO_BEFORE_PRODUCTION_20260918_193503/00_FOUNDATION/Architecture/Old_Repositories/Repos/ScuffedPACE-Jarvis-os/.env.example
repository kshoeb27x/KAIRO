# JARVIS OS — local configuration
# Copy to .env and adjust. Never commit .env.

# Where SQLite data lives. Relative paths resolve against the project root.
# Defaults to the gitignored .data directory.
JARVIS_DATA_DIR=.data

# Server binding (localhost prototype — keep bound to 127.0.0.1)
HOST=127.0.0.1
PORT=8787

# Model provider:
#   "mock"      — no key needed, honest demo responses
#   "ollama"    — real local model via Ollama (no cloud, no API key)
#   "anthropic" — Claude API (requires ANTHROPIC_API_KEY)
MODEL_PROVIDER=mock

# Required only when MODEL_PROVIDER=anthropic. Server-side only — never exposed
# to the browser and never logged.
ANTHROPIC_API_KEY=

# Model names are not hard-coded; supply the models you want to use.
# Example fast model: a small/fast Claude model. Example deep model: a frontier Claude model.
FAST_MODEL_NAME=
DEEP_MODEL_NAME=

# Timeout for model completions, in milliseconds (applies to all providers).
MODEL_TIMEOUT_MS=45000

# Used only when MODEL_PROVIDER=ollama. Requires Ollama running locally with
# the named model installed (e.g. `ollama pull qwen3:8b-q4_K_M`). Only
# loopback addresses (127.0.0.1 / localhost) are accepted in this prototype;
# prompts never leave this machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b-q4_K_M
# Context window in tokens — 4096 fits an 8 GB GPU comfortably.
OLLAMA_NUM_CTX=4096
# Keep false so hidden model reasoning is never shown or spoken.
OLLAMA_THINK=false
# How long Ollama keeps the model loaded after a request (avoids cold starts).
OLLAMA_KEEP_ALIVE=30m

# Optional local Claude CLI bridge (no API key; uses your existing Claude
# Code login and its normal limits). Disabled by default. When enabled with
# MODEL_PROVIDER=ollama, deep-reasoning requests go to the CLI; you can also
# set MODEL_PROVIDER=claude_cli to use it for everything. Sending registered
# project content through the CLI always asks for approval first.
CLAUDE_CLI_ENABLED=false
CLAUDE_CLI_COMMAND=claude
CLAUDE_CLI_TIMEOUT_MS=120000

# Trading-bot monitoring (read-only). Point at the JSON status report your
# bot writes (format: docs/TRADING_MONITOR_INTERFACE.md). Leave empty for an
# honest "not connected" state. JARVIS can never place, modify, or cancel
# trades — no execution path exists.
TRADING_REPORT_PATH=

# Google (Gmail + Calendar) via official OAuth. Create a "Desktop app" OAuth
# client in Google Cloud Console with the Gmail and Calendar APIs enabled
# (steps: docs/INTEGRATIONS.md), then set these. Connecting starts read-only;
# send/modify permissions are a separate explicit upgrade in the app. Tokens
# are stored in the gitignored .data directory, never in git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
