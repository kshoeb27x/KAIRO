# Runtime
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO

# Voice
JARVIS_WAKE_WORD=Jarvis
JARVIS_STT_PROVIDER=speech_recognition
JARVIS_TTS_PROVIDER=pyttsx3

# Local development alternatives:
# JARVIS_STT_PROVIDER=console
# JARVIS_TTS_PROVIDER=console

# Language model
JARVIS_LLM_PROVIDER=echo
JARVIS_LLM_MODEL=local-echo

# OpenAI-compatible cloud provider:
# JARVIS_LLM_PROVIDER=openai
# JARVIS_LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=replace-me
# JARVIS_LLM_API_BASE_URL=
